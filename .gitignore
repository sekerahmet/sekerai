__pycache__/
*.pyc

# buyuk dokumler: uretilebilir, depoda durmasin
*_dokum.txt

# calisma kurallari: YEREL kalir, depoya girmez
CLAUDE.md

# onkayitlar ve bulgular YEREL kalir (depo PUBLIC)
belge/

# ham kosu verisi: Drive'dan cekilen anlik goruntu/olcum dosyalari.
# Depo PUBLIC ve bunlar 17 MB'lik ikili dosyalar -- ASLA girmemeli.
veri/

# arsiv: model_z oncesi her sey (eski kollar, eski belgeler). YERELDE durur, depoda DURMAZ.
# (Gecmisi git'te duruyor; diskten silinmedi.)
arsiv/

# kosu ciktilari: ikili, buyuk, yeniden uretilebilir. Depo PUBLIC.
*.pt
*.npz
*.parquet
onbellek/

# kosu ciktilari: anlik goruntu (.pt) + gunluk.  Depo PUBLIC, ikili dosya girmez.
deneme2/*/kosu/

# kol basina olcum kayitlari (OLCULENLER_<N>.md): YEREL kalir, depo PUBLIC
deneme2/*/OLCULENLER_*.md
# egitim klasorlerinin kendi kayitlari (train_<veri>/OLCULENLER_<veri>.md)
deneme2/*/*/OLCULENLER_*.md
# ajan raporlari ve birlesik bulgular (BULGULAR_<N>.md): YEREL kalir
deneme2/*/BULGULAR_*.md
# kosu basina analiz raporlari klasoru (deneme2/<kol>/bulgular/<kosu>/): YEREL kalir
deneme2/*/bulgular/

# Claude Code yerel klasoru (ajan worktree'leri, ayarlar): depo PUBLIC
.claude/
# model notlari yerel: kullanici kararlari ve alintilar (not.md, FIKIRLER_*.md)
deneme2/*/not.md
deneme2/*/FIKIRLER_*.md

# konus_fineweb yerel agirlik onbellegi (checkpoint model agirligi, ~1 GB)
deneme2/model_y/konus_cache/

# konus (V2) yerel agirlik onbellegi
deneme2/v2/konus_cache/
